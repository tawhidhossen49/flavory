# Public values, safe in the browser
SUPABASE_URL=
SUPABASE_ANON_KEY=
SITE_URL=https://your-domain

# Server only. Its SHA-256 lives in Supabase (private.config: server_secret_sha256)
SERVER_SECRET=

# Server only, optional. Needed only for creating staff logins in Settings
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Bot protection switches on when both are set

TURNSTILE_SECRET_KEY=
