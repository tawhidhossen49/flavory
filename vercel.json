{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["fra1"],
  "functions": {
    "api/receipt-image.js": { "includeFiles": "assets/**" }
  },
  "rewrites": [
    { "source": "/r/:token/:kind(image|preview)", "destination": "/api/receipt-image?token=:token&kind=:kind" },
    { "source": "/r/:token", "destination": "/api/receipt?token=:token" },
    { "source": "/sitemap.xml", "destination": "/api/seo?file=sitemap" },
    { "source": "/robots.txt", "destination": "/api/seo?file=robots" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qkjkthmtluqzzzxpdcmj.supabase.co; font-src 'self'; connect-src 'self' https://qkjkthmtluqzzzxpdcmj.supabase.co; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(fonts|brand|vendor)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
